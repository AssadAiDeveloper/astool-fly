 "steps": [
  {
   "title": {
    "ar": "أرسل طلبك",
    "en": "Send your request"
   },
   "desc": {
    "ar": "املأ نموذج الطلب وأرسله إلى المكتب عبر واتساب.",
    "en": "Fill in the request form and send it to the office on WhatsApp."
   }
  },
  {
   "title": {
    "ar": "نؤكد المتطلبات",
    "en": "We confirm requirements"
   },
   "desc": {
    "ar": "يحدد المكتب المستندات والتفاصيل المطلوبة لحالتك.",
    "en": "The office confirms the documents and details needed for your case."
   }
  },
  {
   "title": {
    "ar": "تجهيز الطلب",
    "en": "We prepare the request"
   },
   "desc": {
    "ar": "ترسل المستندات ويجهز المكتب الطلب أو الحجز.",
    "en": "You send the documents and the office prepares the request or booking."
   }
  },
  {
   "title": {
    "ar": "المتابعة والتسليم",
    "en": "Follow-up and handover"
   },
   "desc": {
    "ar": "يتابع المكتب الطلب معك حتى الإنجاز.",
    "en": "The office keeps you updated until it is done."
   }
  }
 ],
 "faq": [
  {
   "q": {
    "ar": "كيف أطلب خدمة؟",
    "en": "How do I request a service?"
   },
   "a": {
    "ar": "اختر الخدمة في صفحة الطلب واكتب اسمك وتفاصيل رحلتك. يجهز الموقع رسالة جاهزة ترسلها إلى المكتب عبر واتساب.",
    "en": "Pick the service on the request page and add your name and trip details. The site prepares a ready message that you send to the office on WhatsApp."
   }
  },
  {
   "q": {
    "ar": "ما المستندات المطلوبة للتأشيرات والجوازات؟",
    "en": "Which documents are needed for visas and passports?"
   },
   "a": {
    "ar": "تختلف المستندات بحسب نوع الخدمة والوجهة. بعد وصول طلبك يؤكد لك المكتب المتطلبات الخاصة بحالتك.",
    "en": "Documents depend on the service and the destination. After your request arrives, the office confirms what your case needs."
   }
  },
  {
   "q": {
    "ar": "كم السعر؟",
    "en": "What are the prices?"
   },
   "a": {
    "ar": "يختلف السعر بحسب الخط والتاريخ والخدمة. يرسل لك المكتب السعر بعد استلام طلبك.",
    "en": "Prices depend on the route, the date and the service. The office sends you the price after receiving your request."
   }
  },
  {
   "q": {
    "ar": "هل أستطيع إرسال طرود خارج السعودية؟",
    "en": "Can I send parcels beyond Saudi Arabia?"
   },
   "a": {
    "ar": "الطرود المعلنة حالياً هي داخل اليمن وإلى السعودية. اسأل المكتب عن وجهات أخرى عند إرسال طلبك.",
    "en": "Parcels currently listed are within Yemen and to Saudi Arabia. Ask the office about other destinations when you send your request."
   }
  }
 ],
